. recode age ///
>     (19/24 = 1 "19-24") ///
>     (25/29 = 2 "25-29") ///
>     (30/34 = 3 "30-34") ///
>     (35/39 = 4 "35-39") ///
>     (40/44 = 5 "40-44") ///
>     (45/49 = 6 "45-49") ///
>     (50/54 = 7 "50-54") ///
>     (55/59 = 8 "55-59") ///
>     (60/64 = 9 "60-64") ///
>     (else = .), gen(age_cat)
(2,866,349 differences between age and age_cat)

. drop if age_cat == .
(988,524 observations deleted)

. 
. recode sex ///
