. gen med_yr2011 = medicaid * (year == 2011)

. gen med_yr2012 = medicaid * (year == 2012)

. gen med_yr2014 = medicaid * (year == 2014)

. gen med_yr2015 = medicaid * (year == 2015)

. gen med_yr2016 = medicaid * (year == 2016)

. 
