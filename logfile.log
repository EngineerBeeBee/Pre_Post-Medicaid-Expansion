. *** Importing ***
. *************************************************************************************************************************
. 
. foreach y of numlist 2011/2016 {
  2.             
.     import sasxport5 "$raw/LLCP`y'.XPT", clear
  3.     compress
  4.     rename *, lower
  5.     
.     gen year = `y'
  6.     gen id = _n
  7.     
.     *** Year-specific Renaming ***
.         if `y' == 2011 | `y' == 2012 {
  8.         rename _race_g race_g
  9.     }
 10.     else {
 11.         rename (_age80 _race_g1 employ1) (age race_g employ)
 12.     }
 13.     
.     keep `keepvars'
 14.     save "$raw/`y'", replace
 15. }
